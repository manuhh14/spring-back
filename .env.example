# Copia este archivo como .env y rellena los valores
SERVER_PORT=8080
DB_URL=jdbc:postgresql://127.0.0.1:5432/residencias-db
DB_USERNAME=postgres
DB_PASSWORD=cambia-esto
# Minimo 32 caracteres. Puedes generar una con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32+
ADMIN_CORREO=admin@residencias.com
ADMIN_PASSWORD=cambia-esto
# Microservicio de recomendaciones (FastAPI). Usa la misma clave que su variable API_KEY
RECOMENDACIONES_URL=http://localhost:8081
RECOMENDACIONES_API_KEY=cambia-esto-por-la-misma-clave-del-microservicio
