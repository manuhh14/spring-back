meta {
  name: Asignar asesor
  type: http
  seq: 7
}

patch {
  url: {{baseUrl}}/api/postulaciones/{{idPostulacion}}/asesor
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "idAsesor": {{idAsesor}}
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
