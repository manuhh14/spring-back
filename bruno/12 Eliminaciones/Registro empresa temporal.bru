meta {
  name: Registro empresa temporal
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/registro/empresa
  body: json
  auth: none
}

body:json {
  {
    "correo": "empresa{{sufijo}}b@test.com",
    "password": "Password123",
    "razonSocial": "Temporal {{sufijo}}",
    "nombreContacto": "Contacto"
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("idEmpresa2", res.body.idEmpresa);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
