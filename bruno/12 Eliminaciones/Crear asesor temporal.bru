meta {
  name: Crear asesor temporal
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/asesores
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "correo": "asesor{{sufijo}}b@test.com",
    "password": "Password123",
    "nombreCompleto": "Asesor Temporal",
    "maximoAlumnos": 1
  }
}

script:post-response {
  if (res.status === 201) bru.setVar("idAsesor2", res.body.idAsesor);
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
